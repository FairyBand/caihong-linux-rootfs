# Source branches for the kernel build. Every build writes the resolved commit
# IDs to build/dependencies.resolved.env. libcamera and qbootctl are built
# as RPMs in the fairyband/caihong Copr project.
LINUX_REPOSITORY=https://github.com/Osilvfe/linux.git
LINUX_REF=caihong-v7.3
MKBOOTIMG_REPOSITORY=https://android.googlesource.com/platform/system/tools/mkbootimg
MKBOOTIMG_REF=main
