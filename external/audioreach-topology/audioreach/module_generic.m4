include(`util/util.m4') dnl

dnl AR_MODULE_GENERIC(index, name, sgidx, container-idx, module-id, iid,
dnl max-ip-ports, max-op-ports, src-port, dst-port, dst-iid)
define(`AR_MODULE_GENERIC',
`'
`SectionVendorTuples."NAME_PREFIX.$2$1_tuples" {'
`        tokens "audioreach_tokens"'
`'
`        tuples."word.u32_data" {'
`                AR_TKN_U32_MODULE_INSTANCE_ID STR($6)'
`                AR_TKN_U32_MODULE_ID STR($5)'
`                AR_TKN_U32_MODULE_MAX_IP_PORTS STR($7)'
`                AR_TKN_U32_MODULE_MAX_OP_PORTS STR($8)'
`                AR_TKN_U32_MODULE_SRC_OP_PORT_ID STR($9)'
`                AR_TKN_U32_MODULE_DST_IN_PORT_ID STR($10)'
`                AR_TKN_U32_MODULE_SRC_INSTANCE_ID STR($6)'
`                AR_TKN_U32_MODULE_DST_INSTANCE_ID STR($11)'
`        }'
`}'
`'
`SectionData."NAME_PREFIX.$2$1_data" {'
`        tuples "NAME_PREFIX.$2$1_tuples"'
`}'
`'
`SectionWidget."NAME_PREFIX.$2$1" {'
`        index STR($1)'
`        type "src"'
`        no_pm "true"'
`        subseq "10"'
`        data ['
`                "NAME_PREFIX.sub_graph$3_data"'
`                "NAME_PREFIX.container$4_data"'
`                "NAME_PREFIX.$2$1_data"'
`        ]'
`}') dnl

