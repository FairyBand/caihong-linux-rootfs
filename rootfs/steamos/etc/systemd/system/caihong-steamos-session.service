[Unit]
Description=Caihong SteamOS setup desktop
After=systemd-user-sessions.service systemd-logind.service dbus.service
Conflicts=getty@tty1.service

[Service]
User=alarm
PAMName=login
WorkingDirectory=/home/alarm
Environment=HOME=/home/alarm
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=KDE
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/usr/bin/dbus-run-session /usr/bin/startplasma-wayland
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

[Install]
WantedBy=graphical.target
