set -eu

attempt=1
while [ "$attempt" -le 6 ]; do
	state=$(bluetoothctl show 2>/dev/null || true)
	if printf '%s\n' "$state" | grep -q '^[[:space:]]*Powered: yes$'; then
		echo "Bluetooth controller is powered"
		exit 0
	fi

	timeout 5 bluetoothctl power on >/dev/null 2>&1 || true
	sleep 1
	attempt=$((attempt + 1))
done

echo "Bluetooth controller did not power on" >&2
exit 1
