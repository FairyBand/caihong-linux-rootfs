set -eu

qbootctl=/usr/local/sbin/qbootctl

usage()
{
	cat <<'EOF'
Usage:
  caihong-slot status
  caihong-slot android [--reboot]
  caihong-slot linux [--reboot]
  caihong-slot a|b [--reboot]

The semantic names are resolved from the slot running this Linux system:
  linux    current boot slot
  android  other boot slot

Use a or b to select an explicit slot without applying that mapping.

Switching changes the slot selected for the next boot. It does not write a
boot image or mark either slot successful.
EOF
}

current_slot()
{
	current=$(
		"$qbootctl" -c 2>/dev/null |
			awk '$1 == "Current" && $2 == "slot:" { print $3; exit }'
	) || true

	case "$current" in
		_a) printf '%s\n' a ;;
		_b) printf '%s\n' b ;;
		*) return 1 ;;
	esac
}

if [ "$(id -u)" -ne 0 ]; then
	echo "caihong-slot must be run as root" >&2
	exit 1
fi

if [ ! -x "$qbootctl" ]; then
	echo "missing executable: $qbootctl" >&2
	exit 1
fi

command=${1:-status}
reboot_after=0
running_slot=$(current_slot || true)

case ${2:-} in
	"") ;;
	--reboot) reboot_after=1 ;;
	*) usage >&2; exit 2 ;;
esac

if [ "$#" -gt 2 ]; then
	usage >&2
	exit 2
fi

case "$command" in
	status)
		if [ "$reboot_after" -ne 0 ]; then
			usage >&2
			exit 2
		fi
		case "$running_slot" in
			a) echo "Detected mapping: _a=Caihong Linux, _b=Android" ;;
			b) echo "Detected mapping: _b=Caihong Linux, _a=Android" ;;
			*) echo "Detected mapping: unavailable; use explicit a or b" ;;
		esac
		"$qbootctl" 2>/dev/null
		exit 0
		;;
	android)
		case "$running_slot" in
			a) target=b ;;
			b) target=a ;;
			*)
				echo "unable to identify the running Linux slot; use explicit a or b" >&2
				exit 1
				;;
		esac
		expected=_$target
		label=Android
		;;
	linux)
		case "$running_slot" in
			a|b) target=$running_slot ;;
			*)
				echo "unable to identify the running Linux slot; use explicit a or b" >&2
				exit 1
				;;
		esac
		expected=_$target
		label="Caihong Linux"
		;;
	a)
		target=a
		expected=_a
		label="slot A"
		;;
	b)
		target=b
		expected=_b
		label="slot B"
		;;
	-h|--help|help)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 2
		;;
esac

"$qbootctl" -s "$target"
sync

active=$("$qbootctl" -a 2>/dev/null | awk '{print $NF}')
if [ "$active" != "$expected" ]; then
	echo "slot verification failed: expected $expected, found ${active:-unknown}" >&2
	exit 1
fi

echo "Next boot: $label ($expected)"

if [ "$reboot_after" -eq 0 ]; then
	echo "Reboot when ready, or run: caihong-slot $command --reboot"
	exit 0
fi

echo "Rebooting into $label"
systemctl reboot
