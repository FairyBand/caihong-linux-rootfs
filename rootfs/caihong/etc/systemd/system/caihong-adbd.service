[Unit]
Description=Caihong ADB device-mode daemon
After=sys-kernel-config.mount systemd-modules-load.service systemd-udevd.service local-fs.target
Requires=sys-kernel-config.mount
ConditionPathExistsGlob=/sys/class/udc/*

[Service]
Type=notify
NotifyAccess=all
Environment=HOME=/root
Environment=LD_LIBRARY_PATH=/usr/lib/caihong-adbd
Environment=ADBD_USER=root
ExecStartPre=+/usr/local/sbin/caihong-adbd-gadget setup
ExecStart=/usr/local/sbin/caihong-adbd-run
ExecStartPost=+/usr/local/sbin/caihong-adbd-gadget bind
ExecStopPost=+/usr/local/sbin/caihong-adbd-gadget teardown
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s

[Install]
WantedBy=multi-user.target
