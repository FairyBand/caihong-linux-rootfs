set -eu

config=/home/alarm/.config/kglobalshortcutsrc

# PowerDevil keeps the generic keyboard-backlight actions in the user's
# shortcut file even when the hardware action is unsupported.  Caihong's Pogo
# has no keyboard backlight, so remove only those stale actions.
[ -f "$config" ] || exit 0
tmp=$(mktemp "${config}.XXXXXX")
trap 'rm -f "$tmp"' EXIT
sed \
	-e '/^Decrease Keyboard Brightness=/d' \
	-e '/^Increase Keyboard Brightness=/d' \
	-e '/^Toggle Keyboard Backlight=/d' \
	"$config" > "$tmp"
chown --reference="$config" "$tmp"
chmod --reference="$config" "$tmp"
mv -f "$tmp" "$config"
trap - EXIT

# A running KGlobalAccel instance caches the old action list.  Reloading the
# two affected user services is safe during boot and makes the change visible
# without requiring a second login.
machine=alarm@
systemctl --user --machine="$machine" try-restart plasma-powerdevil.service \
	plasma-plasmashell.service 2>/dev/null || true
