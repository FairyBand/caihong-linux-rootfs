# Camera frame buffers use the pageable system heap. Keep the reserved
# CMA heaps unavailable so libcamera does not select a small platform heap and
# fail before it can fall back to /dev/dma_heap/system.
SUBSYSTEM=="dma_heap", KERNEL=="system", GROUP="video", MODE="0660"
SUBSYSTEM=="dma_heap", KERNEL!="system", GROUP="root", MODE="0600"
