[Unit]
Description=Seed the stock-derived KWin automatic brightness curve
After=local-fs.target
Before=sddm.service
ConditionPathExists=/home/alarm/.config/kwinoutputconfig.json

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/caihong-fix-kwin-brightness
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
