[Unit]
Description=Power on the Caihong Bluetooth controller
Wants=bluetooth.service
After=bluetooth.service caihong-hardware-mac.service
StartLimitIntervalSec=300s
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/caihong-bluetooth-autostart
Restart=on-failure
RestartSec=5s
TimeoutStartSec=45s

[Install]
WantedBy=multi-user.target
