post_install()
{
	/usr/lib/linux-caihong/install-current-slot
}

post_upgrade()
{
	/usr/lib/linux-caihong/install-current-slot
}

pre_remove()
{
	/usr/lib/linux-caihong/install-current-slot --remove-modules
}
