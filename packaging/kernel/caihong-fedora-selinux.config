# Fedora targeted SELinux requires the LSM and its network/path hooks to be
# built into the Caihong kernel.  Keep this as a fragment so it is applied
# after caihong_defconfig and remains visible in the generated release config.
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_SECURITYFS=y
CONFIG_AUDIT=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETWORK_SECMARK=y
CONFIG_LSM="landlock,lockdown,yama,integrity,selinux,bpf,ipe"
